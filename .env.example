# 数据模式: jnb(走Tushare API) 或 websearch(走网络搜索)
DATA_MODE=jnb

# Tushare API 配置
# 注意：以下两项仅在 DATA_MODE=jnb 时必须填写
TUSHARE_TOKEN=你...n
# Tushare 中转 API 地址（必填，如果使用 websearch 模式则忽略）
# 格式: http://your-proxy-server.com
# 示例: https://tt.xiaodefa.cn
TUSHARE_API_URL=
# TUSHARE_VERIFY_TOKEN_URL=*** 可选，实时行情验证地址

# 数据库配置
DATA_DIR=data
DB_PATH=data/stock_data.db

# LLM 配置（意图识别后的回答生成，可选）
# 未配置 LLM_API_KEY 时不生成回答，仅显示意图识别结果。
# 这里必须留空：填任何占位串都会被当成真 key 送出去，拿回 401，
# 而不是干净地降级成「不生成回答」（modules/llm_providers.py 只判空）。
# 支持 OpenAI 兼容格式的 API。
LLM_API_KEY=
# 以下四项代码里都有默认值，只在换供应商/调参时才需要覆盖。
# 现役配置（Kimi K3）：
# LLM_BASE_URL=https://api.kimi.com/coding/v1/chat/completions
# LLM_MODEL=k3
# LLM_TEMPERATURE=1
# LLM_MAX_TOKENS=
# 向量知识库配置（可选，默认关闭）
# KB_ENABLED=true  # 取消注释以启用
# KB_API_URL=http://localhost:8000

# 主动推送配置（可选，自选股触发预警时会推送到该飞书 webhook）
# 示例：https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
IM_PUSH_WEBHOOK=

# Kimi Code 多智能体股票调研（可选）
# KIMI_CLI_PATH=/root/.kimi-code/bin/kimi
# KIMI_RESEARCH_MODEL=k3
# 单次 Swarm 最长运行时间；有活动时允许继续，默认 3600 秒
# KIMI_RESEARCH_TIMEOUT=3600
# 连续无任何会话活动多久后降级使用已完成的子报告，默认 600 秒
# KIMI_RESEARCH_IDLE_TIMEOUT=600
# 最终报告汇总最长运行时间，默认 900 秒
# KIMI_RESEARCH_SYNTHESIS_TIMEOUT=900
# KIMI_RESEARCH_WORKERS=1
# KIMI_RESEARCH_MAX_PENDING=5
# KIMI_RESEARCH_HOURLY_LIMIT=10
