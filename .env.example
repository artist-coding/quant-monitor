# 数据模式: jnb(走Tushare API) 或 websearch(走网络搜索)
DATA_MODE=jnb

# Tushare API 配置
# 注意：以下两项仅在 DATA_MODE=jnb 时必须填写
TUSHARE_TOKEN=你...n
# Tushare 中转 API 地址（必填，如果使用 websearch 模式则忽略）
# 格式: http://your-proxy-server.com
# 示例: https://tt.xiaodefa.cn
TUSHARE_API_URL=
# TUSHARE_VERIFY_TOKEN_URL=*** 可选，实时行情验证地址

# 数据库配置
DATA_DIR=data
DB_PATH=data/stock_data.db

# LLM 配置（意图识别后的回答生成，可选）
# 未配置 LLM_API_KEY 时不生成回答，仅显示意图识别结果。
# 这里必须留空：填任何占位串都会被当成真 key 送出去，拿回 401，
# 而不是干净地降级成「不生成回答」（modules/llm_providers.py 只判空）。
# 支持 OpenAI 兼容格式的 API。
LLM_API_KEY=
# 以下四项代码里都有默认值，只在换供应商/调参时才需要覆盖。
# 现役配置（Kimi K3）：
# LLM_BASE_URL=https://api.kimi.com/coding/v1/chat/completions
# LLM_MODEL=k3
# LLM_TEMPERATURE=1
# LLM_MAX_TOKENS=
# 向量知识库配置（可选，默认关闭）
# KB_ENABLED=true  # 取消注释以启用
# KB_API_URL=http://localhost:8000

# 主动推送配置（可选，自选股触发预警时会推送到该飞书 webhook）
# 示例：https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
IM_PUSH_WEBHOOK=

# Kimi Code 多智能体股票调研（可选）
# KIMI_CLI_PATH=/root/.kimi-code/bin/kimi
# KIMI_RESEARCH_MODEL=k3
# 单次 Swarm 最长运行时间；有活动时允许继续，默认 3600 秒
# KIMI_RESEARCH_TIMEOUT=3600
# 连续无任何会话活动多久后降级使用已完成的子报告，默认 600 秒
# KIMI_RESEARCH_IDLE_TIMEOUT=600
# 最终报告汇总最长运行时间，默认 900 秒
# KIMI_RESEARCH_SYNTHESIS_TIMEOUT=900
# KIMI_RESEARCH_WORKERS=1
# KIMI_RESEARCH_MAX_PENDING=5
# KIMI_RESEARCH_HOURLY_LIMIT=10

# 高阶行情数据层（modules/advanced_data.py）
# 打的是东财/同花顺/财联社的公开网页接口（Tushare 账号没权限的资金面/情绪面/结构面等），
# 这类接口没有配额文档，只有封 IP，所以按数据源分别限流。
# 为什么是 0.6：上游不发 403 也不说"请求过于频繁"，失败一律表现为连接被重置（TLS 层），
# 所以没有任何显式配额可依。
# 【2026-08-25 实测修正】此前记的是"与频率无关"，那是错的：对 31 条接口连续探活的过程中，
# push2.eastmoney.com 的成功率随累计请求量单调下降（curl 打同一 URL：3/3 → 1/15 → 4/10 → 0/10），
# 冷却 4 分钟不足以恢复。就是频率问题，只是上游用连接重置而不是状态码来表达。
# 还要注意这个间隔**管不到 akshare 函数内部的翻页**：_rate_limit 在 fetch 里只调一次，
# 而一次 fetch 可能翻上百页（jgdy 144 页、ths_concept_list 39 页），那些请求零间隔。
# 也就是说 0.6 秒是"两次 fetch 之间"的下限，不是"两次 HTTP 请求之间"的下限。
ADVANCED_MIN_INTERVAL=0.6
# 高阶数据缓存独立成库，刻意不进 data/stock_data.db：主库本来就有并发写锁压力
# （zt / zt-web / zt-monitor / cron 同时在写），这一层是"取不到很正常"的旁路数据，
# 不该让它的写入去和行情主线抢锁。不设时默认落在 DATA_DIR 下。
# ADVANCED_CACHE_PATH=data/advanced_cache.db

# ============================================================
# 活跃市值每日同步（scripts/sync_amv.py + scripts/sync_amv_baidu.sh）
# ============================================================
# 活跃市值是选股的总开关（modules/amv.py）。它停更一天，那天就没有开关可用——
# get_regime 会静悄悄回退到上一条，拿几天前的区间继续放行/拦截选股，不报任何错。
#
# 分享链接和提取码**必须放在这里而不是脚本里**：主仓库是公开的。
# 整段分享文本也能识别，但建议就填纯链接。
# AMV_BAIDU_SHARE_URL=https://pan.baidu.com/s/xxxxxxxxxxxx
# AMV_BAIDU_SHARE_PWD=xxxx

# 网盘里的中转目录。脚本每次运行会**清空**它，别往里放别的东西。
# 百度网盘没有"直接下载分享文件"的公开接口，只能先转存到自己的网盘再下载，
# 这个目录就是那个中转站。
# AMV_BAIDU_PAN_WORKDIR=/auto_dl

# 本地归档目录与文件名前缀，默认 data/amv/baidu/活跃市值_YYYYMMDD.<ext>
# AMV_BAIDU_ARCHIVE_DIR=data/amv/baidu
# AMV_BAIDU_PREFIX=活跃市值
# AMV_BAIDU_KEEP_DAYS=90                # 归档保留天数，0 = 永久

# 下载后删除网盘中转文件；中转文件会落进回收站占空间，所以默认顺带清空回收站。
# 回收站里有别的重要东西的话，把 CLEAR_RECYCLE 改成 0。
# AMV_BAIDU_CLEAN_PAN=1
# AMV_BAIDU_CLEAR_RECYCLE=1

# 下载模式 locate / pcs / stream。locate 偶尔报 user is not authorized，
# 脚本会自动回退到 pcs 再试一次，两种都不行才算失败。
# AMV_BAIDU_MODE=locate

# BaiduPCS-Go 是非官方客户端，默认清掉本机代理（百度网盘是境内服务，走代理有害无益，
# 且本机 socks5 代理打断数据通路时报错指向错误方向）。确实要走代理时设成 1。
# AMV_BAIDU_KEEP_PROXY=0

# 失败告警命令，消息在 $MSG 里；留空则只写日志 + journalctl。
# Cookie 过期是必然会发生的（1~3 个月），没有告警可能几周后才发现数据断了。
# AMV_BAIDU_NOTIFY_CMD='curl -s -d chat_id=xxx --data-urlencode "text=$MSG" https://api.telegram.org/botxxx/sendMessage'
# Server酱（微信推送）:
# AMV_BAIDU_NOTIFY_CMD='curl -s -d "title=网盘下载失败" --data-urlencode "desp=$MSG" https://sctapi.ftqq.com/你的KEY.send'
# 系统邮件:
# AMV_BAIDU_NOTIFY_CMD='echo "$MSG" | mail -s "网盘下载失败" you@example.com'
