[Unit]
Description=每交易日收盘后触发活跃市值同步
Documentation=file:///home/zx/quant-monitor/deploy/README.md

[Timer]
# 20:05 主跑（北京时间）。刻意比日线同步（20:00）晚 5 分钟，两个原因：
#
# 1. 脚本要拿 daily_kline 的最新交易日判断活跃市值有没有落后。日线还没入库时
#    两边一样旧，落后天数恒为 0，那道防线就等于没有——不报错，只是不再报警。
# 2. 两条同步写的是同一个 SQLite 主库，同时起容易撞 database is locked。
#
# service 里还写了 After=quant-monitor-sync.service 做第二道保险：
# 两个 job 万一排进同一个事务，systemd 会按顺序跑。
OnCalendar=Mon..Fri 20:05
# 22:05 兜底。20:05 时上游没更新的话（脚本报 unchanged / 退出码 2），这次接上。
OnCalendar=Mon..Fri 22:05
# 一天最多两次转存。BaiduPCS-Go 是非官方客户端，频率高了会触发风控，
# 别再往里加触发点。
#
# 关机/休眠错过的触发点，开机后补跑一次。上游是全量表，补跑一次就全追上了。
Persistent=true
AccuracySec=1min
Unit=quant-monitor-amv.service

[Install]
WantedBy=timers.target
