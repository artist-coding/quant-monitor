[Unit]
Description=Quant Monitor post-close A-share daily pipeline (sync -> indicators -> scores)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/quant-monitor
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/quant-monitor/.env
ExecStart=/usr/bin/python3 -m modules.cli daily-run --json
# 整条链 = 全市场日线 + 7 个指数 + 票池指标重算 + 票池评分，
# 指标重算按 250 天逐日回放，票池变大时耗时会明显增长，给 30 分钟余量。
TimeoutStartSec=1800
UMask=0077
Nice=5
